# Copy to .env.local (local) or set in Vercel > Settings > Environment Variables.
# Never commit real values.

# Default weight source for the child screen: simulator | supabase | localws.
# The parent screen (저울 tab) can pick another one per device.
# supabase = the signed-in parent's first registered scale.
NEXT_PUBLIC_WEIGHT_SOURCE=simulator
# localws only: the scale's address, e.g. ws://192.168.0.23:81 (works from http://localhost pages only)
NEXT_PUBLIC_LOCAL_WS_URL=

# Supabase > Project Settings > API (public values; data is protected by RLS).
# Tables live in schema "nyamnyam" (supabase/migrations); add it to Data API > Exposed schemas.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
